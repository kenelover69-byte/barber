<!doctype html>
<html lang="uk">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#0b0c0d" />
  <meta name="description" content="BLACKLINE — барбершоп нового покоління. Чіткі форми, сильний стиль і запис онлайн." />

  <title>BLACKLINE — Барбершоп нового покоління</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="styles.css" />
</head>

<body>
  <div class="noise" aria-hidden="true"></div>

  <div class="topline">
    <span>КИЇВ · УКРАЇНА</span>
    <span class="live"><i></i> ЗАПИС ВІДКРИТО</span>
    <span>ПН—НД / 10:00—21:00</span>
  </div>

  <header class="site-header" id="top">
    <a class="brand" href="#top" aria-label="BLACKLINE — на головну">
      <span class="brand-mark">B<span>/</span>L</span>
      <span class="brand-name">
        BLACKLINE
        <small>BARBER STUDIO</small>
      </span>
    </a>

    <button
      class="menu-toggle"
      aria-label="Відкрити меню"
      aria-expanded="false"
    >
      <span></span>
      <span></span>
    </button>

    <nav class="nav">
      <a href="#services">ПОСЛУГИ</a>
      <a href="#team">МАЙСТРИ</a>
      <a href="#studio">ПРО НАС</a>
      <a href="#contacts">КОНТАКТИ</a>
    </nav>

    <a class="header-book" href="#booking">
      ЗАПИСАТИСЯ <span>↗</span>
    </a>
  </header>

  <main>

    <!-- HERO -->
    <section class="hero section-pad">
      <div class="hero-gridline" aria-hidden="true"></div>

      <div class="hero-copy reveal">
        <div class="eyebrow">
          <span class="eyebrow-line"></span>
          НЕ ПРОСТО СТРИЖКА. ТВОЯ ФОРМА.
        </div>

        <h1>
          ЗНАЙДИ<br>
          СВОЮ <em>ЛІНІЮ.</em>
        </h1>

        <p class="hero-intro">
          Точність у деталях. Характер у кожному русі.
          Барберинг для тих, хто не залишає стиль на випадок.
        </p>

        <div class="hero-actions">
          <a class="button button-acid" href="#booking">
            ОБРАТИ ЧАС <span>↗</span>
          </a>

          <a class="text-link" href="#services">
            ПЕРЕГЛЯНУТИ ПОСЛУГИ <span>↓</span>
          </a>
        </div>

        <div class="hero-meta">
          <div>
            <strong>01<span>/</span>01</strong>
            <small>ТВІЙ НОВИЙ РИТУАЛ</small>
          </div>

          <div class="meta-rule"></div>

          <div>
            <strong>45<span>—</span>60</strong>
            <small>ХВИЛИН ДЛЯ СЕБЕ</small>
          </div>
        </div>
      </div>

      <div class="hero-visual reveal delay-1">
        <div class="image-frame">
          <img
            src="https://images.unsplash.com/photo-1503951914875-452162b0f3f1?auto=format&fit=crop&w=1300&q=85"
            alt="Інтер'єр сучасного барбершопу"
          >

          <div class="image-overlay"></div>

          <span class="frame-index">FIG. 001 / STUDIO</span>

          <span class="vertical-label">
            CRAFT IS A DISCIPLINE
          </span>

          <div class="circle-stamp">
            <span>BLACKLINE<br>BARBER STUDIO</span>
            <b>✳</b>
          </div>
        </div>

        <div class="side-note">
          <span>01 — 04</span>
          <span>КУЛЬТУРА ТОЧНОСТІ</span>
        </div>
      </div>

      <div class="hero-bottom">
        <span>SCROLL TO EXPLORE <b>↓</b></span>
        <span class="hero-bottom-center">EST. 2021 / KYIV</span>
        <span>ВПЕВНЕНІСТЬ ПОЧИНАЄТЬСЯ З ДЕТАЛЕЙ</span>
      </div>
    </section>

    <!-- MOVING TICKER -->
    <section class="ticker" aria-label="Наш підхід">
      <div class="ticker-track">
        <span>ЧІТКІ ЛІНІЇ</span>
        <b>✳</b>
        <span>ЧЕСНИЙ СЕРВІС</span>
        <b>✳</b>
        <span>СИЛЬНИЙ ХАРАКТЕР</span>
        <b>✳</b>
        <span>ЧІТКІ ЛІНІЇ</span>
        <b>✳</b>
        <span>ЧЕСНИЙ СЕРВІС</span>
        <b>✳</b>
        <span>СИЛЬНИЙ ХАРАКТЕР</span>
        <b>✳</b>
      </div>
    </section>

    <!-- SERVICES -->
    <section class="services section-pad" id="services">
      <div class="section-head reveal">
        <div>
          <div class="eyebrow">
            <span class="eyebrow-line"></span>
            01 / НАШІ ПОСЛУГИ
          </div>

          <h2>
            МЕНШЕ ШУМУ.<br>
            <em>БІЛЬШЕ ФОРМИ.</em>
          </h2>
        </div>

        <p>
          Без зайвих рухів. Підбираємо форму під тебе,
          працюємо з текстурою й завершуємо кожну деталь вручну.
        </p>
      </div>

      <div class="service-layout">
        <div class="service-feature reveal">
          <img
            src="https://images.unsplash.com/photo-1621605815971-fbc98d665033?auto=format&fit=crop&w=1000&q=85"
            alt="Майстер виконує чоловічу стрижку"
          >

          <div class="feature-caption">
            <span>THE CRAFT / 001</span>
            <span>МАЙСТЕРНІСТЬ У КОЖНОМУ РУСІ</span>
          </div>
        </div>

        <div class="service-list reveal delay-1">

          <button
            class="service-row active"
            data-service="Чоловіча стрижка"
            data-price="600"
            data-duration="45 хв"
          >
            <span class="service-num">01</span>
            <span class="service-info">
              <strong>Чоловіча стрижка</strong>
              <small>Форма, текстура, фініш</small>
            </span>
            <span class="service-price">600 ₴</span>
            <span class="service-arrow">↗</span>
          </button>

          <button
            class="service-row"
            data-service="Стрижка + борода"
            data-price="850"
            data-duration="60 хв"
          >
            <span class="service-num">02</span>
            <span class="service-info">
              <strong>Стрижка + борода</strong>
              <small>Цілісний образ і точні контури</small>
            </span>
            <span class="service-price">850 ₴</span>
            <span class="service-arrow">↗</span>
          </button>

          <button
            class="service-row"
            data-service="Оформлення бороди"
            data-price="400"
            data-duration="30 хв"
          >
            <span class="service-num">03</span>
            <span class="service-info">
              <strong>Оформлення бороди</strong>
              <small>Архітектура та догляд</small>
            </span>
            <span class="service-price">400 ₴</span>
            <span class="service-arrow">↗</span>
          </button>

          <button
            class="service-row"
            data-service="Стрижка машинкою"
            data-price="450"
            data-duration="30 хв"
          >
            <span class="service-num">04</span>
            <span class="service-info">
              <strong>Стрижка машинкою</strong>
              <small>Чистий силует без компромісів</small>
            </span>
            <span class="service-price">450 ₴</span>
            <span class="service-arrow">↗</span>
          </button>

          <button
            class="service-row"
            data-service="Підліткова стрижка"
            data-price="500"
            data-duration="45 хв"
          >
            <span class="service-num">05</span>
            <span class="service-info">
              <strong>Підліткова стрижка</strong>
              <small>Свіжа форма, твій характер</small>
            </span>
            <span class="service-price">500 ₴</span>
            <span class="service-arrow">↗</span>
          </button>

          <div class="service-foot">
            <span>УСІ ЦІНИ — У ГРИВНЯХ</span>
            <a href="#booking">ЗАПИС НА ПОСЛУГУ <b>↗</b></a>
          </div>

        </div>
      </div>
    </section>

    <!-- MANIFESTO -->
    <section class="manifesto" id="studio">
      <div class="manifesto-bg">BL</div>

      <div class="manifesto-inner reveal">
        <div class="eyebrow">
          <span class="eyebrow-line"></span>
          02 / ФІЛОСОФІЯ BLACKLINE
        </div>

        <h2>
          СТИЛЬ — ЦЕ НЕ ТРЕНД.<br>
          ЦЕ <em>ТВОЄ РІШЕННЯ.</em>
        </h2>

        <div class="manifesto-bottom">
          <p>
            Ми створили простір, де майстерність важливіша за поспіх.
            Де кожна консультація починається з діалогу, а кожна
            стрижка — з розуміння твого стилю.
          </p>

          <div class="manifesto-sign">
            CUT WITH INTENTION <span>✳</span>
          </div>
        </div>
      </div>
    </section>

    <!-- TEAM -->
    <section class="team section-pad" id="team">
      <div class="section-head reveal">
        <div>
          <div class="eyebrow">
            <span class="eyebrow-line"></span>
            03 / ЛЮДИ ЗА ФОРМОЮ
          </div>

          <h2>
            ТВОЯ ГОЛОВА.<br>
            <em>НАШЕ РЕМЕСЛО.</em>
          </h2>
        </div>

        <p>
          Не просто майстри, а люди, які розуміють пропорції,
          текстуру й те, як форма працює саме для тебе.
        </p>
      </div>

      <div class="team-grid">

        <article class="barber-card reveal">
          <div class="barber-photo">
            <img
              src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=900&q=85"
              alt="Портрет барбера Артема"
            >

            <span class="barber-id">BL / 001</span>

            <button class="barber-book" data-master="Артем">
              ЗАПИСАТИСЯ ↗
            </button>
          </div>

          <div class="barber-details">
            <div>
              <h3>АРТЕМ</h3>
              <p>FADE · CLASSIC · TEXTURE</p>
            </div>
            <span>01</span>
          </div>
        </article>

        <article class="barber-card reveal delay-1">
          <div class="barber-photo">
            <img
              src="https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&w=900&q=85"
              alt="Портрет барбера Максима"
            >

            <span class="barber-id">BL / 002</span>

            <button class="barber-book" data-master="Максим">
              ЗАПИСАТИСЯ ↗
            </button>
          </div>

          <div class="barber-details">
            <div>
              <h3>МАКСИМ</h3>
              <p>BEARD · SCISSOR · MODERN</p>
            </div>
            <span>02</span>
          </div>
        </article>

        <article class="barber-card reveal delay-2">
          <div class="barber-photo">
            <img
              src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=900&q=85"
              alt="Портрет барбера Данила"
            >

            <span class="barber-id">BL / 003</span>

            <button class="barber-book" data-master="Данило">
              ЗАПИСАТИСЯ ↗
            </button>
          </div>

          <div class="barber-details">
            <div>
              <h3>ДАНИЛО</h3>
              <p>BUZZ · FADE · CREATIVE</p>
            </div>
            <span>03</span>
          </div>
        </article>

      </div>

      <div class="team-note">
        <span>КОМАНДА, ЩО ПОМІЧАЄ ДЕТАЛІ</span>
        <span>КИЇВ / BLACKLINE STUDIO</span>
      </div>
    </section>

    <!-- BOOKING -->
    <section class="booking section-pad" id="booking">
      <div class="booking-copy reveal">
        <div class="eyebrow">
          <span class="eyebrow-line"></span>
          04 / ТВОЯ ЧЕРГА
        </div>

        <h2>
          ЧАС ЗРОБИТИ<br>
          <em>ЦЕ ТОЧНО.</em>
        </h2>

        <p>
          Обери послугу, майстра й зручний час.
          Ми подбаємо про решту.
        </p>

        <div class="booking-aside">
          <span class="aside-symbol">↘</span>
          <span>НЕ ВІДКЛАДАЙ СВІЙ НАСТУПНИЙ ОБРАЗ.</span>
        </div>
      </div>

      <div class="booking-panel reveal delay-1">
        <div class="panel-top">
          <span>ONLINE BOOKING / 001</span>
          <span class="panel-dot"><i></i> LIVE FORM</span>
        </div>

        <form id="bookingForm">

          <label>
            01 — ПОСЛУГА
            <select id="bookingService" required>
              <option value="Чоловіча стрижка|600|45 хв">
                Чоловіча стрижка — 600 ₴
              </option>
              <option value="Стрижка + борода|850|60 хв">
                Стрижка + борода — 850 ₴
              </option>
              <option value="Оформлення бороди|400|30 хв">
                Оформлення бороди — 400 ₴
              </option>
              <option value="Стрижка машинкою|450|30 хв">
                Стрижка машинкою — 450 ₴
              </option>
              <option value="Підліткова стрижка|500|45 хв">
                Підліткова стрижка — 500 ₴
              </option>
            </select>
          </label>

          <label>
            02 — МАЙСТЕР
            <select id="bookingMaster" required>
              <option value="Будь-який майстер">Будь-який майстер</option>
              <option value="Артем">Артем</option>
              <option value="Максим">Максим</option>
              <option value="Данило">Данило</option>
            </select>
          </label>

          <div class="form-split">
            <label>
              03 — ДАТА
              <input id="bookingDate" type="date" required />
            </label>

            <label>
              04 — ЧАС
              <select id="bookingTime" required>
                <option value="">Оберіть час</option>
                <option>10:00</option>
                <option>11:00</option>
                <option>12:00</option>
                <option>13:00</option>
                <option>14:00</option>
                <option>15:00</option>
                <option>16:00</option>
                <option>17:00</option>
                <option>18:00</option>
                <option>19:00</option>
                <option>20:00</option>
              </select>
            </label>
          </div>

          <label>
            05 — ТВОЄ ІМ’Я
            <input
              id="bookingName"
              type="text"
              placeholder="Як до тебе звертатися"
              autocomplete="name"
              required
              minlength="2"
            />
          </label>

          <label>
            06 — ТЕЛЕФОН
            <input
              id="bookingPhone"
              type="tel"
              placeholder="+380 __ ___ __ __"
              autocomplete="tel"
              required
            />
          </label>

          <div class="booking-summary">
            <div>
              <small>ТВОЄ ЗАМОВЛЕННЯ</small>
              <strong id="summaryService">Чоловіча стрижка</strong>
              <span id="summaryMeta">45 хв · 600 ₴</span>
            </div>

            <strong id="summaryPrice">600 ₴</strong>
          </div>

          <button class="button button-acid submit-button" type="submit">
            ПЕРЕЙТИ ДО ЗАПИСУ <span>↗</span>
          </button>

          <p class="form-disclaimer">
            Демонстраційна форма. Для реального запису
            підключіть віджет або API Altegio.
          </p>

          <div
            class="form-message"
            id="formMessage"
            role="status"
            aria-live="polite"
          ></div>
        </form>

        <div class="panel-bottom">
          <span>BLACKLINE / KYIV</span>
          <span>YOUR TIME. YOUR STYLE.</span>
        </div>
      </div>
    </section>

    <!-- CONTACTS -->
    <section class="visit section-pad" id="contacts">
      <div class="visit-head reveal">
        <div class="eyebrow">
          <span class="eyebrow-line"></span>
          05 / ЗНАЙДИ НАС
        </div>

        <h2>
          ЗУСТРІНЕМОСЯ<br>
          <em>У КРІСЛІ.</em>
        </h2>
      </div>

      <div class="visit-grid">
        <div class="visit-image reveal">
          <img
            src="https://images.unsplash.com/photo-1599351431202-1e0f0137899a?auto=format&fit=crop&w=1100&q=85"
            alt="Робоче місце барбера"
          >
          <span>INSIDE BLACKLINE / KYIV</span>
        </div>

        <div class="visit-details reveal delay-1">

          <div class="contact-item">
            <small>АДРЕСА</small>
            <strong>Київ, Україна</strong>
            <p>Точну адресу буде додано після підтвердження локації.</p>
          </div>

          <div class="contact-item">
            <small>ГРАФІК</small>
            <strong>ЩОДНЯ / 10:00—21:00</strong>
            <p>За попереднім записом.</p>
          </div>

          <div class="contact-item">
            <small>ЗВ’ЯЗОК</small>
            <strong>+38 (0__) ___ __ __</strong>
            <p>Номер телефону потрібно замінити на реальний.</p>
          </div>

          <a class="button button-outline" href="#booking">
            ЗАБРОНЮВАТИ ЧАС <span>↗</span>
          </a>

          <div class="social-links">
            <a href="#contacts" aria-label="Instagram">IG ↗</a>
            <a href="#contacts" aria-label="Telegram">TG ↗</a>
            <a href="#contacts" aria-label="TikTok">TT ↗</a>
          </div>

        </div>
      </div>
    </section>
  </main>

  <!-- FOOTER -->
  <footer class="footer">
    <a class="brand" href="#top">
      <span class="brand-mark">B<span>/</span>L</span>
      <span class="brand-name">
        BLACKLINE
        <small>BARBER STUDIO</small>
      </span>
    </a>

    <span class="footer-center">CRAFT IS A DISCIPLINE.</span>

    <span class="footer-right">
      © BLACKLINE 2026
      <a href="#top">НАГОРУ ↑</a>
    </span>
  </footer>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <script src="script.js"></script>
</body>
</html>